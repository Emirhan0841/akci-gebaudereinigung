# SMTP Configuration (optional - without this, contact form won't send emails)
# You can use Gmail, Outlook, or any SMTP provider

# For Gmail (requires App Password, not regular password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@akci-gebaeudereinigung.de
# SMTP_TO=akci.gebaeudereinigung@gmail.com

# For other providers, adjust accordingly
